# ─────────────────────────────────────────────────────────────────────────────
# Climate Cognitive System — environment template
# Copy to .env and fill the values. .env is gitignored; this file is committed.
#
# Note: MONGO_URI and POSTGRES_URI are NOT set here — docker-compose.yml injects
# them pointing to the `mongo` / `postgres` service names inside the network.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=climate_db

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# If left empty, the backend generates a random one at boot (tokens reset on restart).
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Initial password for the auto-seeded 'admin' account.
# Empty/default ("admin") is ONLY acceptable for local development —
# any public deployment MUST set a strong value here.
ADMIN_PASSWORD=

# ── Deployment timezone ───────────────────────────────────────────────────────
# Whole-hour UTC offset to phase-align the diurnal drift. -5 = America/Lima (UTEC).
LOCAL_UTC_OFFSET_HOURS=-5

# ── IBM Watson Assistant — Dirección A (widget → Watson) ──────────────────────
# From watsonx Assistant → Assistant settings → "Assistant IDs and API details".
# API key: IBM Cloud → your Watson Assistant instance → Service credentials.
WATSON_API_KEY=
WATSON_URL=https://api.<region>.assistant.watson.cloud.ibm.com/instances/<instance-id>
# v2 runtime uses the ENVIRONMENT ID as assistant_id (NOT the Assistant ID).
# Use the Draft env ID for dev, the Live env ID for production after Publish.
WATSON_ASSISTANT_ID=

# ── Watson Custom Extension — Dirección B (Watson → backend) ──────────────────
# Self-invented shared key. Gates /sensors and /chat (header X-API-Key).
# NOTE: this is an anti-abuse gate, NOT a real secret — the frontend build bakes
# it into the public JS bundle, so anyone can extract it from a deployed site.
# Real device authentication would need per-device keys (see roadmap).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# MUST be identical in 3 places:
#   1. here (backend)
#   2. frontend build  → frontend/.env.local  VITE_API_KEY
#   3. Watson Custom Extension → Authentication → API key (header X-API-Key)
WATSON_EXTENSION_KEY=
